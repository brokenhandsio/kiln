#extend("base"):
#export("content"):
<article class="blog-container">
    <header class="blog-post-header">
        <div id="blog-time-tag-container">
            <div id="blog-time-tags" class="d-flex">
                #if(blogPost.hasTags):
                <div class="blog-tags">
                    <ul class="mx-auto mx-lg-0 flex-wrap">
                        #for(tag in blogPost.tags):<li class="my-1"><a href="#(tag.url)">#(tag.name)</a></li>#endfor
                    </ul>
                </div>
                #endif
                <div id="blog-post-reading-time">#(blogPost.readingTimeText)</div>
            </div>
        </div>
        <h1 class="mb-4 mt-4">#(blogPost.title)</h1>
        <div class="blog-post-author d-flex">
            #for(author in blogPost.authors):#if(author.hasImage):#if(author.hasPage):<a href="#(author.pageURL)" aria-hidden="true" tabindex="-1"><img class="blog-post-author-image me-2" src="#(author.imageURL)" alt="#(author.name)"></a>#else:<img class="blog-post-author-image me-2" src="#(author.imageURL)" alt="#(author.name)">#endif#endif#endfor
            <div class="blog-post-author-date-container">
                <div class="blog-post-author-name">#for(author in blogPost.authors):<span>#if(author.hasPage):<a href="#(author.pageURL)" rel="author">#(author.name)</a>#else:#(author.name)#endif</span>#endfor</div>
                <div class="blog-post-publish-date">Published <time datetime="#(blogPost.isoDate)">#(blogPost.formattedDate)</time></div>
            </div>
        </div>
    </header>

    <hr class="blog-post-divider">

    <div class="blog-content">
        #unsafeHTML(blogPost.content)
    </div>

    #if(blogPost.hasTags):
    <hr class="blog-post-divider">
    <footer id="blog-post-bottom">
        <div id="blog-bottom-tags" class="blog-tags">
            <ul class="mx-auto mx-lg-0 flex-wrap">
                #for(tag in blogPost.tags):<li class="my-1"><a href="#(tag.url)">#(tag.name)</a></li>#endfor
            </ul>
        </div>
    </footer>
    #endif
</article>
#endexport
#endextend
