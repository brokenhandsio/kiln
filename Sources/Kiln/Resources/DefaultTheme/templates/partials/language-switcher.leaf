#if(count(languages) > 1):
<div class="kiln-lang-switcher">
    <button type="button" class="kiln-lang-button" aria-haspopup="true" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
        <span>#(language.name)</span>
    </button>
    <ul class="kiln-lang-menu">
        #for(alt in languages):
        <li><a href="#(alt.url)" class="kiln-lang-option#if(alt.isCurrent): kiln-current#endif">#(alt.name)</a></li>
        #endfor
    </ul>
</div>
#endif
