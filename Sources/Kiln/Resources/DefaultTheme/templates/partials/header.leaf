<header class="kiln-header">
    <button class="kiln-menu-toggle" id="kiln-menu-toggle" aria-label="#(strings.toggleNavigation)" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a class="kiln-logo" href="/">
        #if(site.logo):<img src="/#(site.logo)" alt="#(site.name)" class="kiln-logo-img">#endif
        <span class="kiln-logo-text">#(site.name)</span>
    </a>

    <div class="kiln-header-spacer"></div>

    #if(site.searchEnabled):
    #extend("partials/search")
    <button class="kiln-search-toggle" id="kiln-search-toggle" aria-label="#(strings.searchPlaceholder)" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
    </button>
    #endif

    <div class="kiln-controls kiln-controls-header">
        #extend("partials/controls")
    </div>
</header>
