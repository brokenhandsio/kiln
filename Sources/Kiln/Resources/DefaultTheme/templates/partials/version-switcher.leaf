#if(count(versions) > 1):
<div class="kiln-version-switcher">
    <button type="button" class="kiln-version-button" aria-haspopup="true" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>#(currentVersion.name)</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <ul class="kiln-version-menu">
        #for(ver in versions):
        <li><a href="#(ver.url)" class="kiln-version-option#if(ver.isCurrent): kiln-current#endif#if(ver.isPrerelease): kiln-prerelease#endif#if(ver.deprecated): kiln-deprecated#endif">#(ver.name)</a></li>
        #endfor
    </ul>
</div>
#endif
