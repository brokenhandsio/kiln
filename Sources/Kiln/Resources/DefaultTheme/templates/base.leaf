<!DOCTYPE html>
<html lang="#(language.locale)" dir="#(language.direction)">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#if(page.isHome):#(site.name)#else:#(page.title) · #(site.name)#endif</title>
    <link rel="canonical" href="#(page.canonicalURL)">
    #if(markdownURL):<link rel="alternate" type="text/markdown" href="#(markdownURL)">#endif
    #if(page.description):<meta name="description" content="#(page.description)">#endif
    #if(site.author):<meta name="author" content="#(site.author)">#endif
    <meta name="theme-color" content="#(site.palette.primary)">
    <meta name="generator" content="Kiln">
    #if(noindex):<meta name="robots" content="noindex">#endif

    <!-- Open Graph -->
    <meta property="og:type" content="#if(blogListing):website#elseif(page.isHome):website#else:article#endif">
    <meta property="og:title" content="#if(page.isHome):#(site.name)#else:#(page.title)#endif">
    #if(page.description):<meta property="og:description" content="#(page.description)">#endif
    <meta property="og:url" content="#(page.canonicalURL)">
    <meta property="og:site_name" content="#(site.name)">
    <meta property="og:locale" content="#(language.ogLocale)">
    #for(alt in languages):#if(!alt.isCurrent):<meta property="og:locale:alternate" content="#(alt.ogLocale)">
    #endif#endfor
    #if(page.imageURL):<meta property="og:image" content="#(page.imageURL)">
    <meta property="og:image:alt" content="#if(page.isHome):#(site.name)#else:#(page.title)#endif">
    #if(page.imageType):<meta property="og:image:type" content="#(page.imageType)">#endif#endif
    #if(blogPost):<meta property="article:published_time" content="#(blogPost.isoDateTime)">
    #for(author in blogPost.authors):<meta property="article:author" content="#(author.name)">
    #endfor#for(tag in blogPost.tags):<meta property="article:tag" content="#(tag.name)">
    #endfor#endif

    <!-- Twitter -->
    <meta name="twitter:card" content="#if(page.imageURL):summary_large_image#else:summary#endif">
    #if(site.twitterSite):<meta name="twitter:site" content="#(site.twitterSite)">#endif
    <meta name="twitter:title" content="#if(page.isHome):#(site.name)#else:#(page.title)#endif">
    #if(page.description):<meta name="twitter:description" content="#(page.description)">#endif
    #if(page.imageURL):<meta name="twitter:image" content="#(page.imageURL)">
    <meta name="twitter:image:alt" content="#if(page.isHome):#(site.name)#else:#(page.title)#endif">#endif

    #if(site.favicon):<link rel="icon" href="#(basePath)/#(site.favicon)">#endif

    #for(alt in languages):<link rel="alternate" hreflang="#(alt.locale)" href="#(alt.absoluteURL)">
    #if(alt.isDefault):<link rel="alternate" hreflang="x-default" href="#(alt.absoluteURL)">
    #endif#endfor

    <link rel="stylesheet" href="#(basePath)/_kiln/css/theme.css">
    #for(href in site.extraCSS):<link rel="stylesheet" href="#(basePath)/#(href)">
    #endfor

    <style>
        :root {
            --kiln-primary: #(site.palette.primary);
            --kiln-accent: #(site.palette.accent);
            #if(site.fonts):--kiln-font-text: "#(site.fonts.text)", system-ui, sans-serif;
            --kiln-font-code: "#(site.fonts.code)", ui-monospace, monospace;#endif
        }
    </style>
    <script>
        // Apply the saved (or configured) colour scheme before paint to avoid a flash.
        (function () {
            var stored = localStorage.getItem("kiln-palette");
            var mode = stored || "#(site.palette.mode)";
            if (mode === "auto") {
                mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-palette", mode);
        })();
    </script>
    #if(page.structuredData):<script type="application/ld+json">#unsafeHTML(page.structuredData)</script>#endif
</head>
<body>
    <a class="kiln-skip-link" href="#kiln-main">#(strings.skipToContent)</a>
    #extend("partials/header")

    <div class="kiln-backdrop" id="kiln-backdrop"></div>

    <div class="kiln-layout#if(!page.showSidebar): kiln-no-sidebar#endif#if(!page.showTOC): kiln-no-toc#endif">
        #if(page.showSidebar):
        <aside class="kiln-sidebar" id="kiln-sidebar">
            <div class="kiln-controls kiln-controls-drawer">
                #extend("partials/controls")
            </div>
            #if(nav.moduleSwitcher):#unsafeHTML(nav.moduleSwitcher)#endif
            <nav class="kiln-nav" aria-label="Main navigation">
                #if(nav.doccHTML):#unsafeHTML(nav.doccHTML)#else:#extend("partials/nav-tree", nav)#endif
            </nav>
        </aside>
        #endif

        <main class="kiln-main" id="kiln-main" tabindex="-1">
            #if(isVersioned):#if(!isLatest):
            #if(currentVersion.isPrerelease):
            <div class="admonition note kiln-version-notice">
                <p>#(strings.preReleaseMessage) <a href="#(latestURL)">#(strings.preReleaseLink)</a></p>
            </div>
            #else:
            <div class="admonition warning kiln-version-notice">
                <p>#(strings.oldVersionMessage) <a href="#(latestURL)">#(strings.oldVersionLink)</a></p>
            </div>
            #endif
            #endif#endif

            #if(page.isFallback):
            <div class="admonition kiln-fallback">
                <p class="admonition-title">#(strings.fallbackTitle)</p>
                <p>#(strings.fallbackMessage)</p>
            </div>
            #endif

            #if(page.isFallback):
            <div class="kiln-fallback-content" lang="#(site.defaultLocale)" dir="#(site.defaultDir)">
                #import("content")
            </div>
            #else:
            #import("content")
            #endif

            <nav class="kiln-page-nav" aria-label="Page navigation">
                #if(nav.previous):<a class="kiln-prev" href="#(nav.previous.url)"><span class="kiln-page-nav-label">#(strings.previousPage)</span><span class="kiln-page-nav-title">#(nav.previous.title)</span></a>#endif
                #if(nav.next):<a class="kiln-next" href="#(nav.next.url)"><span class="kiln-page-nav-label">#(strings.nextPage)</span><span class="kiln-page-nav-title">#(nav.next.title)</span></a>#endif
            </nav>

            #if(page.editURL):<a class="kiln-edit-link" href="#(page.editURL)">#(strings.editPage)</a>#endif
        </main>

        #if(page.showTOC):
        <aside class="kiln-toc">
            #if(page.hasTOC):
            <div class="kiln-toc-inner">
                <p class="kiln-toc-title">#(strings.tableOfContentsTitle)</p>
                #extend("partials/toc")
            </div>
            #endif
            #if(site.carbonAds):
            <div class="kiln-carbon" id="kiln-carbon" data-serve="#(site.carbonAds.serve)" data-placement="#(site.carbonAds.placement)"></div>
            #endif
        </aside>
        #endif
    </div>

    #extend("partials/footer")

    <script>window.kilnSearchIndex = "#(searchIndexURL)"; window.kilnVersionBase = "#(basePath)#(versionBasePath)";</script>
    <script src="#(basePath)/_kiln/js/vendor/highlight.min.js"></script>
    <script src="#(basePath)/_kiln/js/theme.js"></script>
    #if(site.searchEnabled):<script src="#(basePath)/_kiln/js/search.js"></script>#endif
    #for(src in site.extraJS):<script src="#(basePath)/#(src)"></script>
    #endfor
</body>
</html>
